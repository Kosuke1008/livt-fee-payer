# Kairos proof only. Use a new, dedicated EOA and fund its public address with
# only the minimum Kairos KAIA needed for this review.
BLOCKCHAIN_NETWORK=kairos
FEE_PAYER_KAIROS_PRIVATE_KEY=

# The live runner generates this value per run. Set it manually only when the
# sidecar is started without the runner.
FEE_PAYER_API_KEY=
MAINNET_PAYMENT_AUTHORIZATION_KEY=

FEE_PAYER_KAIROS_RPC_URL=https://public-en-kairos.node.kaia.io
FEE_PAYER_PORT=19000
FEE_PAYER_MAX_GAS=150000
FEE_PAYER_RECEIPT_TIMEOUT_MS=45000
FEE_PAYER_KILL_SWITCH=false
FEE_PAYER_MIN_RESERVE_KAIA=0

# Mainnet external signer metadata. Never put a Mainnet private key or static
# AWS credentials here. Runtime auth uses the host's IAM role/instance identity.
FEE_PAYER_KAIA_MAINNET_RPC_URL=
FEE_PAYER_KAIA_MAINNET_SECONDARY_RPC_URL=
FEE_PAYER_KAIA_MAINNET_ADDRESS=
FEE_PAYER_KAIROS_ADDRESS=
FEE_PAYER_MAINNET_SIGNER_TYPE=external
FEE_PAYER_MAINNET_SIGNER_BACKEND=aws-kms
FEE_PAYER_AWS_REGION=
FEE_PAYER_AWS_KMS_KEY_ID=
FEE_PAYER_SIGNER_TIMEOUT_MS=5000
FEE_PAYER_MAINNET_ENABLED=false
SELF_HOSTED_MAINNET_FEE_PAYER_ENABLED=false
FEE_PAYER_MAINNET_SIGNING_ENABLED=false
FEE_PAYER_MAINNET_BROADCAST_ENABLED=false
FEE_PAYER_ALLOW_CROSS_NETWORK_IDENTITY=false
# Required and reported by Phase 11 read-only readiness. A lower current
# balance is reported as NOT_FUNDED; Phase 12 execution still rejects it.
# Keep the actual reserve deliberately small.
# FEE_PAYER_MIN_RESERVE_KAIA=0.1

# Development-only compatibility bypass. Both values are required, it is
# rejected with NODE_ENV=production, and it can never apply to kaia-mainnet.
FEE_PAYER_SKIP_KAIROS_CHECK=0
FEE_PAYER_DEVELOPMENT_BYPASS_ENABLED=0

# Legacy Kairos names remain accepted during migration:
# FEE_PAYER_PRIVATE_KEY=
# KAIROS_RPC_URL=
# FEE_PAYER_TOKEN_CONTRACT=0xe7c3d8c9a439fede00d2600032d5db0be71c3c29
# FEE_PAYER_KILL_SWITCH must remain true for Phase 11 Mainnet readiness.
