# Kairos proof only. Use a new, dedicated EOA and fund its public address with
# only the minimum Kairos KAIA needed for this review.
BLOCKCHAIN_NETWORK=kairos
FEE_PAYER_KAIROS_PRIVATE_KEY=

# The live runner generates this value per run. Set it manually only when the
# sidecar is started without the runner.
FEE_PAYER_API_KEY=

FEE_PAYER_KAIROS_RPC_URL=https://public-en-kairos.node.kaia.io
FEE_PAYER_PORT=19000
FEE_PAYER_MAX_GAS=150000
FEE_PAYER_RECEIPT_TIMEOUT_MS=45000

# Read-only profile configuration only. Phase 1 has no Mainnet key, signer,
# server startup, signing, broadcast, or fee delegation path.
FEE_PAYER_KAIA_MAINNET_RPC_URL=
FEE_PAYER_MAINNET_ENABLED=false

# Development-only compatibility bypass. Both values are required, it is
# rejected with NODE_ENV=production, and it can never apply to kaia-mainnet.
FEE_PAYER_SKIP_KAIROS_CHECK=0
FEE_PAYER_DEVELOPMENT_BYPASS_ENABLED=0

# Legacy Kairos names remain accepted during migration:
# FEE_PAYER_PRIVATE_KEY=
# KAIROS_RPC_URL=
# FEE_PAYER_TOKEN_CONTRACT=0xe7c3d8c9a439fede00d2600032d5db0be71c3c29
